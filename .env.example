# Federato HTN API (from organizers)
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_AUDIENCE=https://product.federato.ai/core-api
FEDERATO_HANDLER_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true

# Browserbase (work browser for FEMA / Maps) — booth #46 / browserbase.com/settings
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional: enables Stagehand act() on FEMA search (otherwise goto-only)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Gemini — transcribes the meeting audio the goose captures
# aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default gemini-flash-latest fits the ~10 req/min free
# tier. Enable billing / a paid model for steadier, lower-latency transcription.
GEMINI_TRANSCRIBE_MODEL=
# Brain: which Gemini model decides on actions, and how confident it must be to
# auto-act (0..1). Defaults: gemini-flash-latest, 0.7.
GEMINI_BRAIN_MODEL=
BRAIN_CONFIDENCE=

# ElevenLabs — the goose's spoken voice. elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # Daniel by default; `npm run voices -w @plus1/voice` to browse
ELEVENLABS_MODEL=

# ── MongoDB Atlas — where meeting transcripts live ──────────────────────────
# cloud.mongodb.com → your cluster → Connect → Drivers → copy the SRV string,
# and put your real password in place of <db_password>. Unset = in-memory only
# (transcripts vanish when the backend restarts).
MONGODB_URI=
MONGODB_DB=plus1

# Agent server
PORT=8787
DASHBOARD_ORIGIN=http://localhost:3000

# Screenshare helper — Playwright joins this Meet and Presents the live-view tab
MEET_URL=
# First run: sign into Google in the headed Chrome window (profile is reused)

# ── plus1 avatar (packages/liveavatar, packages/voice; used by apps/backend meet sessions) ──
LIVEAVATAR_API_KEY=                 # app.liveavatar.com -> Developers
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a   # Wayne (sandbox avatar); swap for the goose
LIVEAVATAR_SANDBOX=1                # 1 = free ~1 min sessions, Wayne only. 0 = production, costs credits
GOOSE_NAME=Reginald                 # display name when joining as a guest
# MEET_PROFILE_DIR=apps/runner-profile   # Chrome profile the goose joins with (default apps/backend/cache/screenshare-profile)
