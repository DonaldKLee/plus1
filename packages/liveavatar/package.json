{
  "name": "@plus1/liveavatar",
  "version": "0.1.0",
  "private": true,
  "description": "HeyGen LiveAvatar (LITE mode) integration for plus1: session control, PCM streaming, and the in-page media bridge that turns the avatar into the runner's fake camera and mic.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:page && tsc -p tsconfig.build.json",
    "build:page": "node scripts/build-page.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.page.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "preview": "npm run build:page && tsx scripts/preview-server.ts",
    "avatars": "tsx scripts/list.ts avatars",
    "voices": "tsx scripts/list.ts voices",
    "check:browser": "npm run build:page && node scripts/browser-check.mjs",
    "prepare": "node scripts/build-page.mjs",
    "e2e:browser": "node scripts/build-page.mjs && node scripts/browser-e2e.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "livekit-client": "^2.22.0",
    "tsx": "^4.19.0",
    "typescript": "5.7.3",
    "vitest": "^3.0.0",
    "playwright-core": "^1.50.0"
  }
}
