# Federato HTN API (from organizers)
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_AUDIENCE=https://product.federato.ai/core-api
FEDERATO_HANDLER_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true

# Browserbase (work browser / jev agent Shannon presents on demand)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: reuse a Browserbase Agent definition (does not spend a run by itself)
BROWSERBASE_AGENT_ID=
# Set to 1 to skip agents.runs and always use the OpenAI page driver (good when
# you're out of agent runs for the month).
BROWSERBASE_SKIP_AGENTS=
# Optional PNG shown in the Present work tab between Browserbase agent runs
# (defaults to apps/backend/assets/work-hold-logo.png).
WORK_HOLD_LOGO=

# Optional: Stagehand act() model key (also used by OpenAI Realtime + page driver)
OPENAI_API_KEY=
# Talk path for Meet sessions — both stacks are fully wired:
#   legacy = Gemini Live transcription + ElevenLabs TTS into LiveAvatar
#   openai = OpenAI Realtime speech-to-speech into LiveAvatar
TALK_BACKEND=legacy
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral
# semantic_vad eagerness: high (~2s) | medium/auto (~4s) | low (~8s)
OPENAI_REALTIME_EAGERNESS=high
# Optional model for the Browserbase page driver (default gpt-4o-mini)
OPENAI_BROWSER_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Gemini — transcribes the meeting audio the plus1 captures
# aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default gemini-flash-latest fits the ~10 req/min free
# tier. Enable billing / a paid model for steadier, lower-latency transcription.
GEMINI_TRANSCRIBE_MODEL=
# Brain: which Gemini model decides on actions, and how confident it must be to
# auto-act (0..1). Defaults: gemini-flash-latest, 0.7.
GEMINI_BRAIN_MODEL=
# Screenshare glances while jev is working. Default gemini-flash-latest.
GEMINI_VISION_MODEL=
BRAIN_CONFIDENCE=

# ElevenLabs — the plus1's spoken voice. elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # Daniel by default; `npm run voices -w @plus1/voice` to browse
ELEVENLABS_MODEL=

# ── MongoDB Atlas — where meeting transcripts live ──────────────────────────
# cloud.mongodb.com → your cluster → Connect → Drivers → copy the SRV string,
# and put your real password in place of <db_password>. Unset = in-memory only
# (transcripts vanish when the backend restarts).
MONGODB_URI=
MONGODB_DB=plus1

# Agent server
PORT=8787
DASHBOARD_ORIGIN=http://localhost:3000

# Screenshare helper — Playwright joins this Meet and Presents the live-view tab
MEET_URL=
# First run: sign into Google in the headed Chrome window (profile is reused)

# ── plus1 avatar (packages/liveavatar, packages/voice; used by apps/backend meet sessions) ──
LIVEAVATAR_API_KEY=                 # app.liveavatar.com -> Developers
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a   # Wayne (sandbox avatar); swap for the plus1
LIVEAVATAR_SANDBOX=1                # 1 = free ~1 min sessions, Wayne only. 0 = production, costs credits
AGENT_NAME=Shannon                  # display name when joining as a guest
MEET_PROFILE_DIR=                   # Chrome profile the plus1 joins with (default apps/backend/cache/screenshare-profile)

# ── Appwrite (public PDF links in Meet chat) ────────────────────────────────
# cloud.appwrite.io → create a project → Storage → one bucket. In bucket Settings
# add Permission: Role = Any, Access = Read (fileSecurity can stay off). Server
# API key needs storage.read + storage.write. Without Appwrite, PDFs stay
# local-only unless PUBLIC_DOCS + the tunnel are on.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# ── Email (the plus1 sends notes / PDFs) ────────────────────────────────────
# Unset = DRY RUN: the plus1 still drafts the message and builds the PDF, and the
# log shows what would have gone out, but nothing leaves the machine. Turn the
# "Email" server on in the plus1 tab to expose the tools at all.
#
# Easiest path — Gmail with an app password (NOT your account password; needs
# 2-Step Verification on): myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Or any other SMTP provider (Fastmail, Postmark, SES, Resend…). These win only
# if the GMAIL_* pair above is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=            # 1 for implicit TLS (port 465); defaults by port
#
# From / Reply-To. Defaults to GMAIL_USER or SMTP_USER.
EMAIL_FROM=
EMAIL_REPLY_TO=
#
# SAFETY. The thing composing these emails is an LLM listening to a live, often
# misheard audio transcript, and an email can't be unsent. Strongly recommended
# while demoing: a comma-separated list of addresses and/or bare domains the
# plus1 is allowed to mail. Empty = anyone.
EMAIL_ALLOWLIST=        # e.g. me@example.com,mycompany.com
EMAIL_MAX_RECIPIENTS=5  # hard cap per message
EMAIL_DRY_RUN=          # 1 = force drafting even when SMTP is configured

# ── Public share links (the plus1 drops a PDF link into Meet chat) ───────────
# A link is only useful to other people in the meeting if it's reachable from
# outside your laptop. Turn on the public document server, then run the tunnel:
#
#   PUBLIC_DOCS=1      in this file, then restart the backend
#   npm run tunnel     spawns a cloudflared quick tunnel (brew install cloudflared)
#
# The tunnel writes its https://….trycloudflare.com hostname to
# apps/backend/cache/public-url.txt, which the backend reads automatically —
# nothing to paste back in here. Unset PUBLIC_DOCS and the plus1 still makes
# PDFs, they're just download-only in the dashboard.
PUBLIC_DOCS=              # 1 = serve documents on PUBLIC_DOCS_PORT
PUBLIC_DOCS_PORT=8788     # tunnel THIS port, never 8787 (see below)
#
# Set this only for a real deployment or a named tunnel; it overrides the file
# the tunnel script writes.
PUBLIC_BASE_URL=
#
# How long a share link lives. Mongo expires the document itself via a TTL index.
PUBLIC_DOC_TTL_HOURS=24
#
# WHY A SEPARATE PORT: the main backend on 8787 has NO authentication — it can
# launch Chrome and join a meeting as you, rewrite the plus1's config, and its
# chat surface reaches the agent's file and shell tools. Tunnelling 8787 would
# publish all of that. The public app on 8788 serves exactly one GET route.
#
# AND NOTE: a share link is a bearer credential. Anyone who has it can read that
# document — no login. Meeting notes can be sensitive; keep the TTL short.
